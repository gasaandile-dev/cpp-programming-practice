#include <iostream>

int main() {
    int marks;

    std::cout << "Enter your marks: ";
    std::cin >> marks;

    if (marks < 0 || marks > 100) {
        std::cout << "Invalid marks";
    }
    else if (marks >= 50) {
        std::cout << "You passed!";
    }
    else {
        std::cout << "You failed!";
    }

    return 0;
}
